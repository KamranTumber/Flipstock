# Copy to .env and edit. Every value is optional.

# --- eBay official Browse API (recommended) ---------------------------------
# eBay often refuses automated requests to its search pages. Free keys from
# https://developer.ebay.com (Production "App ID" + "Cert ID") make active-listing
# search reliable, and give a labelled fallback valuation if sold pages are refused.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Facebook Marketplace -----------------------------------------------------
# Your own session cookies from a logged-in browser (DevTools > Application >
# Cookies > https://www.facebook.com). Can also be set in the Settings panel.
FB_C_USER=
FB_XS=
# Marketplace location slug override (e.g. london, manchester, or a numeric id).
# Default: derived from your postcode's district.
FB_LOCATION_SLUG=
# When FB blocks/needs login: "status" (just show the badge) or "demo" (labelled demo items)
FB_FALLBACK=status

# --- Behaviour ----------------------------------------------------------------
# Serve deterministic, clearly labelled demo data from every source (offline use).
DEMO_MODE=false
# Use headless Chromium for JS-rendered pages (FB Marketplace). Needs:
#   python -m playwright install chromium
USE_PLAYWRIGHT=true
PLAYWRIGHT_HEADLESS=true

# Politeness / caching
MIN_REQUEST_INTERVAL=1.2
MAX_RETRIES=2
REQUEST_TIMEOUT=20
LISTING_CACHE_TTL_MIN=15
COMP_CACHE_TTL_MIN=360
MAX_LISTINGS_PER_SOURCE=40
MAX_COMP_LOOKUPS=8
MATCH_THRESHOLD=72

# CeX search (public, search-only Algolia key embedded in uk.webuy.com).
# Update these if CeX rotates them and the CeX badge shows an error.
CEX_ALGOLIA_APP_ID=LNNFEEWZVX
CEX_ALGOLIA_API_KEY=bf79f2b6699e60a18ae330a1248b452c
CEX_ALGOLIA_INDEX=prod_cex_uk

# SQLite location (default: ./data/flipscout.db)
# DATABASE_URL=sqlite:///./data/flipscout.db
